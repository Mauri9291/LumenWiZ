<Window x:Class="LumenWiZ.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:common="clr-namespace:LumenWiZ.UI.Common"
        xmlns:controls="clr-namespace:LumenWiZ.UI.Controls"
        xmlns:vm="clr-namespace:LumenWiZ.UI.ViewModels"
        mc:Ignorable="d"
        Title="LumenWiZ - WiZ Lights Studio"
        Width="920" Height="620"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <common:ValueEqualsConverter x:Key="EqualsConverter"/>

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#71717A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#20FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer shadow window frame -->
    <Border Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.75"/>
        </Border.Effect>

        <!-- Main Window Container -->
        <Border Background="#F2141418" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Custom Title Bar -->
                    <RowDefinition Height="38"/>
                    <!-- Main Body -->
                    <RowDefinition Height="*"/>
                    <!-- Status Bar Footer -->
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <!-- Custom Title Bar -->
                <Grid Grid.Row="0" MouseDown="TitleBar_MouseDown" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="💡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="LumenWiZ" FontWeight="Bold" FontSize="13" Foreground="#F4F4F5" VerticalAlignment="Center"/>
                        <TextBlock Text="· WiZ Lights Studio" FontSize="12" Foreground="#71717A" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource TitleBarButton}" Click="Minimize_Click">
                            <TextBlock Text="🗕" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarButton}" Click="Maximize_Click">
                            <TextBlock Text="🗖" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarButton}" Click="Close_Click">
                            <TextBlock Text="✕" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Window Content (Sidebar + Main Panel) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Sidebar -->
                        <ColumnDefinition Width="220"/>
                        <!-- Main View Panel -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar -->
                    <Border Grid.Column="0" Background="#33000000" BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0" Padding="14,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Habitaciones Header -->
                                <TextBlock Text="HABITACIONES" FontSize="10" FontWeight="Bold" Foreground="#71717A"
                                           Margin="4,4,4,8"/>

                                <!-- Rooms List -->
                                <ItemsControl ItemsSource="{Binding Rooms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SidebarButton}"
                                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🛏️" FontSize="13" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13"/>
                                                    <TextBlock Text="{Binding Devices.Count, StringFormat=' ({0})'}" FontSize="11" Foreground="#71717A"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Separator Background="#15FFFFFF" Margin="0,14,0,14"/>

                                <!-- Funciones Header -->
                                <TextBlock Text="FUNCIONES" FontSize="10" FontWeight="Bold" Foreground="#71717A"
                                           Margin="4,0,4,8"/>

                                <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💡" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="Mis Luces" FontSize="13"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎵" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="Audio Reactivo" FontSize="13"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📸" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="Escenas Guardadas" FontSize="13"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎛️" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="Stream Deck &amp; API" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Main View Panels (Switched via SelectedNavIndex) -->
                    <Grid Grid.Column="1" Margin="20,16">

                        <!-- VIEW 0: HABITACIONES Y CONTROL INDIVIDUAL DE LUCES -->
                        <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=0}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Top Bar: Room Title & Actions -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedRoom.Name, FallbackValue='Mi Habitación'}"
                                               FontSize="18" FontWeight="Bold" Foreground="#F4F4F5"/>
                                    <TextBlock Text="Control individual por foco · Ajuste fino de color y brillo"
                                               FontSize="12" Foreground="#71717A" Margin="0,3,0,0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ActionButton}" Command="{Binding CaptureCurrentSceneCommand}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📸 "/>
                                            <TextBlock Text="Capturar Escena"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButton}" Command="{Binding ScanDevicesCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔍 "/>
                                            <TextBlock Text="Detectar Luces"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Individual Devices List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Devices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:DeviceCard DataContext="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- VIEW 1: AUDIO REACTIVO WASAPI (SPOTIFY / JUEGOS) -->
                        <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=1}">
                            <StackPanel Margin="10,0">
                                <TextBlock Text="Sincronización de Audio Digital WASAPI" FontSize="18" FontWeight="Bold" Foreground="#F4F4F5"/>
                                <TextBlock Text="Captura de alta fidelidad desde Windows (Spotify, YouTube, Juegos) sin usar micrófono"
                                           FontSize="12" Foreground="#71717A" Margin="0,4,0,20"/>

                                <Border Background="#14FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Estado del Motor Reactivo" FontSize="14" FontWeight="SemiBold" Foreground="#F4F4F5"/>
                                            <TextBlock Text="Procesamiento FFT de 3 bandas a 25 FPS sin sobrecargar la red Wi-Fi"
                                                       FontSize="12" Foreground="#A1A1AA" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Style="{StaticResource ActionButton}" Command="{Binding ToggleAudioSyncCommand}"
                                                Padding="20,10" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🎵 " FontSize="14"/>
                                                <TextBlock Text="{Binding IsAudioSyncActive, Converter={x:Null}, FallbackValue='Activar / Detener'}"
                                                           FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Spectrum Frequency Bands -->
                                <TextBlock Text="BANDAS DE FRECUENCIA CONFIGURADAS" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,10"/>

                                <Border Background="#0DFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="🔊 Graves / Bass (20 Hz - 150 Hz)" FontWeight="SemiBold" Foreground="#A855F7"/>
                                            <TextBlock Text="Modula la pulsación rítmica y explosiva de la Tira LED de escritorio." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Asignado a Tira LED" FontSize="11" Foreground="#A855F7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Background="#0DFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="🎚️ Medios / Mids (150 Hz - 2,500 Hz)" FontWeight="SemiBold" Foreground="#3B82F6"/>
                                            <TextBlock Text="Controla la transición armónica de las bombillas de techo principales." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Asignado a Focos Techo" FontSize="11" Foreground="#3B82F6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Background="#0DFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="10" Padding="16">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="🎼 Agudos / Treble (2,500 Hz - 12,000 Hz)" FontWeight="SemiBold" Foreground="#F59E0B"/>
                                            <TextBlock Text="Acentos brillantes y platillos transmitidos a lámparas ambientales." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Asignado a Lámpara Noche" FontSize="11" Foreground="#F59E0B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- VIEW 2: ESCENAS GUARDADAS (INSTANT SNAPSHOTS) -->
                        <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=2}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="Escenas Guardadas Locales" FontSize="18" FontWeight="Bold" Foreground="#F4F4F5"/>
                                <TextBlock Text="Instantáneas de tus 5 luces capturadas en 1 ms y guardadas localmente en tu equipo"
                                           FontSize="12" Foreground="#71717A" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Create New Snapshot Bar -->
                            <Border Grid.Row="1" Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewSceneName, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#1A000000" Foreground="#FFFFFF" BorderBrush="#30FFFFFF"
                                             Padding="10,6" FontSize="12" VerticalAlignment="Center"
                                             ToolTip="Nombre de la nueva escena (ej: Modo Cine, Lectura, Focus)"/>
                                    <Button Grid.Column="1" Style="{StaticResource ActionButton}" Command="{Binding CaptureCurrentSceneCommand}"
                                            Margin="10,0,0,0" Padding="14,6">
                                        <TextBlock Text="📸 Capturar Estado Actual" FontWeight="SemiBold"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Saved Scenes Grid -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CustomScenes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0CFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Icon}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                                                            <TextBlock Text="{Binding DeviceStates.Count, StringFormat='{}{0} luces memorizadas'}"
                                                                       FontSize="11" Foreground="#71717A"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Button Style="{StaticResource ActionButton}"
                                                            Command="{Binding DataContext.ApplySceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,4">
                                                        <TextBlock Text="Aplicar Escena" FontSize="11"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- VIEW 3: STREAM DECK & API REST LOCAL -->
                        <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=3}">
                            <StackPanel Margin="10,0">
                                <TextBlock Text="Stream Deck &amp; API REST Local" FontSize="18" FontWeight="Bold" Foreground="#F4F4F5"/>
                                <TextBlock Text="Controla LumenWiZ desde Stream Deck, scripts de PowerShell o atajos mediante HTTP"
                                           FontSize="12" Foreground="#71717A" Margin="0,4,0,20"/>

                                <Border Background="#14FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="🟢 Servidor REST Local Activo" FontWeight="Bold" Foreground="#10B981" FontSize="13"/>
                                        <TextBlock Text="Escuchando en: http://localhost:38898/api/" FontFamily="Consolas" FontSize="12" Foreground="#F4F4F5" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="ENDPOINTS DISPONIBLES (COMPATIBLE CON STREAM DECK):" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,10"/>

                                <Border Background="#0CFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="GET http://localhost:38898/api/status" FontFamily="Consolas" FontWeight="Bold" Foreground="#F59E0B"/>
                                        <TextBlock Text="Devuelve el estado JSON de todas las luces y habitaciones descubiertas." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#0CFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="POST http://localhost:38898/api/power/toggle?room=1" FontFamily="Consolas" FontWeight="Bold" Foreground="#F59E0B"/>
                                        <TextBlock Text="Enciende o apaga todas las luces de la habitación especificada." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#0CFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="POST http://localhost:38898/api/brightness?value=80" FontFamily="Consolas" FontWeight="Bold" Foreground="#F59E0B"/>
                                        <TextBlock Text="Ajusta el brillo global de la habitación activa (10 a 100%)." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#0CFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="POST http://localhost:38898/api/scenes/activate?name=MiEscena" FontFamily="Consolas" FontWeight="Bold" Foreground="#F59E0B"/>
                                        <TextBlock Text="Aplica al instante una de tus escenas personalizadas guardadas." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                    </Grid>
                </Grid>

                <!-- Status Bar Footer -->
                <Border Grid.Row="2" Background="#26000000" BorderBrush="#10FFFFFF" BorderThickness="0,1,0,0" Padding="16,0">
                    <Grid VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#71717A"/>
                        <TextBlock Text="LumenWiZ v1.0.0 (100% Local &amp; Native)" FontSize="10" Foreground="#52525B" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
