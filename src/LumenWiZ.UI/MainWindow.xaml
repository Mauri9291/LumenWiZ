<ui:FluentWindow x:Class="LumenWiZ.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:common="clr-namespace:LumenWiZ.UI.Common"
        xmlns:controls="clr-namespace:LumenWiZ.UI.Controls"
        xmlns:vm="clr-namespace:LumenWiZ.UI.ViewModels"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="LumenWiZ - WiZ Lights Studio"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        Width="990" Height="680"
        MinWidth="840" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Window.Resources>
        <common:ValueEqualsConverter x:Key="EqualsConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Fluent 2 Toggle Switch Style -->
        <Style x:Key="FluentToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="toggleBg" CornerRadius="11" Background="#2C2C34"
                                BorderBrush="#3D3D48" BorderThickness="1">
                            <Ellipse x:Name="thumb" Width="14" Height="14" Fill="#FFFFFF"
                                     HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="toggleBg" Property="Background" Value="#0078D4"/>
                                <Setter TargetName="toggleBg" Property="BorderBrush" Value="#0078D4"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="toggleBg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Wave Link / Fluent 2 NavRail Button -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E8E96"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Margin="0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1A22"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button (#0078D4) -->
        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1084E3"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1084E3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#006CBE"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#006CBE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button (#222228) -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#222228"/>
            <Setter Property="Foreground" Value="#E2E2EA"/>
            <Setter Property="BorderBrush" Value="#2F2F3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2B2B34"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#424250"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1B1B20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle Icon Button -->
        <Style x:Key="SubtleIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#7E7E88"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25252E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Emoji Quick Selector Pill Button -->
        <Style x:Key="EmojiPillButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1E26"/>
            <Setter Property="BorderBrush" Value="#2D2D38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2B2B38"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#444456"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TitleBar Buttons -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A8A94"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22222A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#A82315"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Fluent 2 Window Root (True Windows 11 Mica Surface) -->
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Fluent 2 Native TitleBar (38px) -->
            <RowDefinition Height="38"/>
            <!-- Main Body -->
            <RowDefinition Height="*"/>
            <!-- Status Footer (28px) -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Fluent 2 Native TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="LumenWiZ"
                     Height="38"
                     CloseWindowByDoubleClickOnIcon="False">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="💡 LumenWiZ" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border Background="#2010B981" BorderBrush="#3010B981" BorderThickness="1"
                            CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" FontSize="9" Foreground="#34D399" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{DynamicResource Loc_LightsConnected}" FontSize="10" FontWeight="SemiBold" Foreground="#34D399" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Window Content (Sidebar + Main Panel) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar / NavRail -->
                <ColumnDefinition Width="220"/>
                <!-- Main View Panel -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar (Fluent 2 Translucent Navigation Rail) -->
            <Border Grid.Column="0" Background="#35141418" BorderBrush="#1F282832" BorderThickness="0,0,1,0" Padding="10,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Habitaciones Header with + Button -->
                        <Grid Margin="6,4,6,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Home24" FontSize="13" Foreground="#6B6B75" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Loc_Rooms}" FontSize="10" FontWeight="Bold" Foreground="#6B6B75" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SubtleIconButton}"
                                    Command="{Binding StartAddRoomCommand}" ToolTip="Crear nueva habitación" Padding="4,2">
                                <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="#0078D4"/>
                            </Button>
                        </Grid>

                        <!-- Add Room Drawer -->
                        <Border Background="#1C1C24" BorderBrush="#2D2D3A" BorderThickness="1" CornerRadius="6"
                                Padding="8,6" Margin="2,0,2,8"
                                Visibility="{Binding IsAddingRoom, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBox Text="{Binding NewRoomName, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#141418" Foreground="#FFFFFF" BorderBrush="#0078D4"
                                         Padding="6,3" FontSize="11" Margin="0,0,0,6"
                                         ToolTip="Nombre de la nueva habitación"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource PrimaryActionButton}" Command="{Binding ConfirmAddRoomCommand}"
                                            Padding="8,3" Margin="0,0,4,0">
                                        <TextBlock Text="{DynamicResource Loc_Create}" FontSize="10"/>
                                    </Button>
                                    <Button Style="{StaticResource ActionButton}" Command="{Binding CancelAddRoomCommand}"
                                            Padding="6,3">
                                        <TextBlock Text="✕" FontSize="10"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Rooms List -->
                        <ItemsControl ItemsSource="{Binding Rooms}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SidebarButton}"
                                            Command="{Binding DataContext.SelectRoomCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Name}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Lightbulb24" FontSize="14" Foreground="#0078D4" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Devices.Count, StringFormat=' ({0})'}" FontSize="11" Foreground="#6B6B75" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="#1F282832" Margin="4,12,4,12"/>

                        <!-- Espacios Header -->
                        <TextBlock Text="{DynamicResource Loc_Spaces}" FontSize="10" FontWeight="Bold" Foreground="#6B6B75"
                                   Margin="6,0,6,8"/>

                        <!-- Nav Item 0: Mis Luces -->
                        <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" Height="16" CornerRadius="1.5" Background="#0078D4" Margin="-4,0,8,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding SelectedNavIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=0}"/>
                                <ui:SymbolIcon Grid.Column="1" Symbol="Lightbulb24" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#0078D4"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource Loc_Nav_MyLights}" FontSize="13" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Nav Item 1: Audio Reactivo -->
                        <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" Height="16" CornerRadius="1.5" Background="#0078D4" Margin="-4,0,8,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding SelectedNavIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=1}"/>
                                <ui:SymbolIcon Grid.Column="1" Symbol="Speaker224" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#A855F7"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource Loc_Nav_AudioReactive}" FontSize="13" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Nav Item 2: Escenas (Predefinidas & Guardadas) -->
                        <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" Height="16" CornerRadius="1.5" Background="#0078D4" Margin="-4,0,8,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding SelectedNavIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=2}"/>
                                <ui:SymbolIcon Grid.Column="1" Symbol="Color24" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#EC4899"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource Loc_Nav_Scenes}" FontSize="13" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Nav Item 3: Stream Deck & API / Ajustes -->
                        <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" Height="16" CornerRadius="1.5" Background="#0078D4" Margin="-4,0,8,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding SelectedNavIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=3}"/>
                                <ui:SymbolIcon Grid.Column="1" Symbol="Settings24" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#38BDF8"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource Loc_Nav_SettingsApi}" FontSize="13" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

                <!-- Main View Panels (Switched via SelectedNavIndex) -->
                <Grid Grid.Column="1" Margin="22,16">

                    <!-- VIEW 0: MIS LUCES (HARDWARE CHANNELS MIXER) -->
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=0}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top Bar: Room Title & Master Mixer Controls -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedRoom.Name, FallbackValue='Mi Habitación'}"
                                               FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <Button Command="{Binding DeleteRoomCommand}" CommandParameter="{Binding SelectedRoom}"
                                            ToolTip="{DynamicResource Loc_DeleteRoomTooltip}" Margin="10,0,0,0" Padding="6,2">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SubtleIconButton}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedRoom.RoomId}" Value="-1">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🗑️" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Loc_DeleteRoom}" FontSize="11" Foreground="#F87171" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Master Room Controls -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Room Master Brightness Fader -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="{DynamicResource Loc_Brightness}" FontSize="12" Foreground="#8E8E96" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Slider Value="{Binding RoomMasterBrightness, Mode=TwoWay}" Minimum="10" Maximum="100" Width="90"
                                            VerticalAlignment="Center" Foreground="#0078D4"/>
                                    <Border Background="#16161B" BorderBrush="#25252E" BorderThickness="1"
                                            CornerRadius="4" Padding="4,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RoomMasterBrightness, StringFormat='{}{0}%'}" FontSize="10" Foreground="#A0A0AA" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>

                                <!-- Master Room Power Toggle -->
                                <ToggleButton IsChecked="{Binding IsRoomMasterOn, Mode=TwoWay}"
                                              ToolTip="{DynamicResource Loc_TurnOnOffRoom}"
                                              Cursor="Hand" Width="42" Height="22" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="toggleBg" CornerRadius="11" Background="#2C2C34"
                                                    BorderBrush="#383842" BorderThickness="1">
                                                <Ellipse x:Name="thumb" Width="16" Height="16" Fill="#FFFFFF"
                                                         HorizontalAlignment="Left" Margin="2,0,0,0">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="toggleBg" Property="Background" Value="#0078D4"/>
                                                    <Setter TargetName="toggleBg" Property="BorderBrush" Value="#0078D4"/>
                                                    <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Button Style="{StaticResource ActionButton}" Command="{Binding ScanDevicesCommand}"
                                        Padding="10,6" ToolTip="{DynamicResource Loc_SearchLights}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔄" FontSize="11" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource Loc_SearchLights}" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Devices Hardware Strips -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:DeviceCard/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- VIEW 1: AUDIO REACTIVO (WASAPI DIGITAL LOOPBACK) -->
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=1}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc_AudioReactive_Title}" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,16"/>

                                <!-- Audio Settings Card -->
                                <Border Background="#17171C" BorderBrush="#25252E" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top: Audio Status & Master Toggle -->
                                        <Grid Grid.Row="0" Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource Loc_AudioDevice_Title}"
                                                           FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="{DynamicResource Loc_AudioDevice_Subtitle}"
                                                           FontSize="11" Foreground="#7E7E88" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource PrimaryActionButton}" Command="{Binding ToggleAudioSyncCommand}"
                                                    Padding="16,8">
                                                <TextBlock Text="{Binding AudioSyncButtonText}"/>
                                            </Button>
                                        </Grid>

                                        <!-- Bottom: Audio Device Selector Dropdown -->
                                        <StackPanel Grid.Row="1">
                                            <StackPanel Orientation="Horizontal">
                                                <ComboBox ItemsSource="{Binding AudioDevices}"
                                                          SelectedItem="{Binding SelectedAudioDevice, Mode=TwoWay}"
                                                          DisplayMemberPath="DisplayName"
                                                          Width="380" MinHeight="36" Padding="8,4" FontSize="12"
                                                          Background="#121216" Foreground="#FFFFFF"
                                                          VerticalAlignment="Center"
                                                          VerticalContentAlignment="Center"/>
                                                <Button Style="{StaticResource ActionButton}" Command="{Binding RefreshAudioDevicesCommand}"
                                                        Margin="8,0,0,0" Padding="10,6" VerticalAlignment="Center" ToolTip="Volver a escanear salidas de sonido">
                                                    <TextBlock Text="{DynamicResource Loc_Refresh}" FontSize="11"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Interactive Bulbs Band Assignment -->
                                <TextBlock Text="{DynamicResource Loc_BandAssignment}" FontSize="10" FontWeight="Bold" Foreground="#6B6B75" Margin="0,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding Devices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#17171C" BorderBrush="#25252E" BorderThickness="1" CornerRadius="8"
                                                    Padding="14,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Name & Type -->
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="{Binding DeviceTypeTag}" FontSize="10" Foreground="#7E7E88"/>
                                                    </StackPanel>

                                                    <!-- Band Selectors -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                                        <Button Content="🔊 Graves" Command="{Binding SetAudioBandCommand}" CommandParameter="Bass" Margin="2,0" Padding="8,4">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsBassBand}" Value="True">
                                                                            <Setter Property="Background" Value="#35A855F7"/>
                                                                            <Setter Property="BorderBrush" Value="#A855F7"/>
                                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <Button Content="🎚️ Medios" Command="{Binding SetAudioBandCommand}" CommandParameter="Mids" Margin="2,0" Padding="8,4">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMidsBand}" Value="True">
                                                                            <Setter Property="Background" Value="#35A855F7"/>
                                                                            <Setter Property="BorderBrush" Value="#A855F7"/>
                                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <Button Content="🎼 Agudos" Command="{Binding SetAudioBandCommand}" CommandParameter="Treble" Margin="2,0" Padding="8,4">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTrebleBand}" Value="True">
                                                                            <Setter Property="Background" Value="#35A855F7"/>
                                                                            <Setter Property="BorderBrush" Value="#A855F7"/>
                                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <Button Content="🌈 Todo" Command="{Binding SetAudioBandCommand}" CommandParameter="Full" Margin="2,0" Padding="8,4">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFullBand}" Value="True">
                                                                            <Setter Property="Background" Value="#35A855F7"/>
                                                                            <Setter Property="BorderBrush" Value="#A855F7"/>
                                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>

                                                    <!-- Current Band Badge -->
                                                    <Border Grid.Column="2" Background="#20A855F7" BorderBrush="#50A855F7" BorderThickness="1"
                                                            CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AudioBandTag}" FontSize="10" Foreground="#D8B4FE" FontWeight="Medium"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- VIEW 2: ESCENAS (CON PESTAÑAS: PREDEFINIDAS Y GUARDADAS) -->
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=2}">
                        <Grid.RowDefinitions>
                            <!-- Header & Segmented Tabs Bar -->
                            <RowDefinition Height="Auto"/>
                            <!-- Content Area -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Segmented Tabs Control -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Gestor de Escenas" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            </StackPanel>

                            <!-- Wave Link Segmented Tab Buttons -->
                            <Border Grid.Column="1" Background="#16161B" BorderBrush="#25252E" BorderThickness="1"
                                    CornerRadius="8" Padding="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Tab 0: Escenas Predefinidas -->
                                    <Button Command="{Binding SelectScenesTabCommand}" CommandParameter="0"
                                            Padding="14,6" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Foreground" Value="#8E8E96"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedScenesTabIndex}" Value="0">
                                                        <Setter Property="Background" Value="#252530"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Sparkle20" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Loc_Tab_Predefined}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Tab 1: Escenas Guardadas -->
                                    <Button Command="{Binding SelectScenesTabCommand}" CommandParameter="1"
                                            Padding="14,6" Cursor="Hand" Margin="2,0,0,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Foreground" Value="#8E8E96"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedScenesTabIndex}" Value="1">
                                                        <Setter Property="Background" Value="#252530"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Camera20" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Loc_Tab_Saved}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Tab 2: Menú Rápido (6 Ranuras) -->
                                    <Button Command="{Binding SelectScenesTabCommand}" CommandParameter="2"
                                            Padding="14,6" Cursor="Hand" Margin="2,0,0,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Foreground" Value="#8E8E96"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedScenesTabIndex}" Value="2">
                                                        <Setter Property="Background" Value="#252530"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Flash20" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Loc_Tab_QuickMenu}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- SUB-VIEW 0: ESCENAS PREDEFINIDAS WIZ (NATIVE FACTORY MODES) -->
                        <Grid Grid.Row="1" Visibility="{Binding SelectedScenesTabIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=0}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Loc_Tab_Predefined}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#8A8A94" Margin="0,0,0,12"/>

                                    <ItemsControl ItemsSource="{Binding PredefinedScenes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#17171C" BorderBrush="#25252E" BorderThickness="1" CornerRadius="8"
                                                        Padding="14,12" Margin="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Icon -->
                                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="24"
                                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                        <!-- Title & Description -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="#FFFFFF"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#7E7E88"
                                                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        </StackPanel>

                                                        <!-- Apply Button -->
                                                        <Button Grid.Column="2" Style="{StaticResource ActionButton}"
                                                                Command="{Binding ApplyCommand}"
                                                                VerticalAlignment="Center" Padding="14,6">
                                                            <TextBlock Text="{DynamicResource Loc_Activate}" FontWeight="SemiBold"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- SUB-VIEW 1: ESCENAS GUARDADAS (INSTANT SNAPSHOTS & TRAY SYNC) -->
                        <Grid Grid.Row="1" Visibility="{Binding SelectedScenesTabIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=1}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Create New Snapshot Card with Emoji Selector -->
                            <Border Grid.Row="0" Background="#17171C" BorderBrush="#25252E" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Emoji Picker Palette (36+ Categorías) -->
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{DynamicResource Loc_ChooseSceneIcon}" FontSize="11" Foreground="#7E7E88" Margin="0,0,0,6"/>
                                        <WrapPanel Orientation="Horizontal">
                                            <!-- Ambientes -->
                                            <Button Style="{StaticResource EmojiPillButton}" Content="☀️" ToolTip="Día / Despertar" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="☀️"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🌅" ToolTip="Atardecer" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🌅"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🌙" ToolTip="Noche" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🌙"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🌌" ToolTip="Galaxia / Espacio" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🌌"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🕯️" ToolTip="Vela" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🕯️"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🔥" ToolTip="Chimenea / Cálido" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🔥"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🌊" ToolTip="Océano / Relax" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🌊"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🌲" ToolTip="Bosque" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🌲"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🌸" ToolTip="Primavera" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🌸"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="⚡" ToolTip="Tormenta" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="⚡"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="❄️" ToolTip="Invierno" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="❄️"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🪐" ToolTip="Cosmos" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🪐"/>

                                            <!-- Actividades -->
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🎬" ToolTip="Cine / Streaming" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🎬"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🎮" ToolTip="Gaming / Discord" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🎮"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🎧" ToolTip="Música / Lo-Fi" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🎧"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="📚" ToolTip="Lectura" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="📚"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="💻" ToolTip="Trabajo / Estudio" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="💻"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="☕" ToolTip="Café / Mañana" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="☕"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🍷" ToolTip="Cena / Vino" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🍷"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🍳" ToolTip="Cocina" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🍳"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🧘" ToolTip="Meditación" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🧘"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🛌" ToolTip="Dormitorio / Descanso" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🛌"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🏋️" ToolTip="Fitness / Energía" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🏋️"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🧹" ToolTip="Limpieza" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🧹"/>

                                            <!-- Efectos y Estilos -->
                                            <Button Style="{StaticResource EmojiPillButton}" Content="💡" ToolTip="Luz General" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="💡"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🌈" ToolTip="RGB / Psicodélico" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🌈"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🎉" ToolTip="Fiesta" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🎉"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="💖" ToolTip="Romance" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="💖"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🔮" ToolTip="Místico / Neón" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🔮"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🍸" ToolTip="Bar / Cocktail" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🍸"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🎨" ToolTip="Arte / Creativo" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🎨"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🛸" ToolTip="Sci-Fi" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🛸"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🚀" ToolTip="Hiperespacio" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🚀"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="🤖" ToolTip="Cyberpunk" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="🤖"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="💎" ToolTip="Diamante" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="💎"/>
                                            <Button Style="{StaticResource EmojiPillButton}" Content="✨" ToolTip="Destellos" Command="{Binding SelectNewSceneIconCommand}" CommandParameter="✨"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Name Input and Capture Button -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Selected Emoji Preview -->
                                        <Border Grid.Column="0" Width="34" Height="32" CornerRadius="4"
                                                Background="#121216" BorderBrush="#25252E" BorderThickness="1"
                                                Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NewSceneIcon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Scene Name TextBox -->
                                        <TextBox Grid.Column="1" Text="{Binding NewSceneName, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#121216" Foreground="#FFFFFF" BorderBrush="#25252E"
                                                 Padding="10,6" FontSize="12" VerticalAlignment="Center"
                                                 ToolTip="Nombre de la nueva escena (ej: Modo Cine, Lectura, Focus)"/>

                                        <!-- Capture Button -->
                                        <Button Grid.Column="2" Style="{StaticResource PrimaryActionButton}" Command="{Binding CaptureCurrentSceneCommand}"
                                                Margin="10,0,0,0" Padding="14,6">
                                            <TextBlock Text="{DynamicResource Loc_CaptureCurrentState}"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Saved Scenes List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CustomScenes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#17171C" BorderBrush="#25252E" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <!-- MODE 1: NORMAL VIEW MODE (When IsEditing == False) -->
                                                    <Grid>
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Scene Identity (Icon + Name + Devices count) -->
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Icon}" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="#FFFFFF"/>
                                                                <TextBlock Text="{Binding DeviceCount, StringFormat='{}{0} luces memorizadas'}"
                                                                           FontSize="11" Foreground="#7E7E88"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Quick Scenes Toggle Button (⭐ Menú Rápido) -->
                                                        <Button Grid.Column="1" Command="{Binding ToggleQuickScenesCommand}"
                                                                Margin="8,0" Padding="10,5" VerticalAlignment="Center">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Cursor" Value="Hand"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="border" CornerRadius="4" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Setter Property="Background" Value="#1E1E26"/>
                                                                    <Setter Property="BorderBrush" Value="#2D2D38"/>
                                                                    <Setter Property="Content">
                                                                        <Setter.Value>
                                                                            <TextBlock Text="☆ Añadir a Rápido" FontSize="11" Foreground="#7E7E88"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Setter Property="ToolTip" Value="Clic para mostrar esta escena en el menú rápido de la bandeja"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShowInQuickScenes}" Value="True">
                                                                            <Setter Property="Background" Value="#2B2412"/>
                                                                            <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                                            <Setter Property="Content">
                                                                                <Setter.Value>
                                                                                    <TextBlock Text="⭐ En Menú Rápido" FontSize="11" FontWeight="SemiBold" Foreground="#FBBF24"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Setter Property="ToolTip" Value="Esta escena está fijada en la bandeja. Clic para quitarla."/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <!-- Action Buttons (Edit, Delete, Apply) -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource SubtleIconButton}" Command="{Binding StartEditCommand}"
                                                                    ToolTip="Editar nombre y emoji" Margin="0,0,4,0">
                                                                <TextBlock Text="✏️" FontSize="13"/>
                                                            </Button>

                                                            <Button Style="{StaticResource SubtleIconButton}" Command="{Binding DeleteCommand}"
                                                                    ToolTip="Eliminar escena guardada" Margin="0,0,8,0">
                                                                <TextBlock Text="🗑️" FontSize="13"/>
                                                            </Button>

                                                            <Button Style="{StaticResource ActionButton}" Command="{Binding ApplyCommand}" Padding="14,5">
                                                                <TextBlock Text="Activar Escena" FontWeight="Medium"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- MODE 2: INLINE EDIT MODE (When IsEditing == True) -->
                                                    <Grid Margin="0,2">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>

                                                        <StackPanel>
                                                            <!-- Emoji Selector Palette for Editing (36+ Categorías) -->
                                                            <StackPanel Margin="0,0,0,8">
                                                                <TextBlock Text="Cambiar icono de la escena:" FontSize="11" Foreground="#7E7E88" Margin="0,0,0,6"/>
                                                                <WrapPanel Orientation="Horizontal">
                                                                    <!-- Ambientes -->
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="☀️" ToolTip="Día" Command="{Binding SelectEmojiCommand}" CommandParameter="☀️"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🌅" ToolTip="Atardecer" Command="{Binding SelectEmojiCommand}" CommandParameter="🌅"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🌙" ToolTip="Noche" Command="{Binding SelectEmojiCommand}" CommandParameter="🌙"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🌌" ToolTip="Galaxia" Command="{Binding SelectEmojiCommand}" CommandParameter="🌌"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🕯️" ToolTip="Vela" Command="{Binding SelectEmojiCommand}" CommandParameter="🕯️"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🔥" ToolTip="Fuego" Command="{Binding SelectEmojiCommand}" CommandParameter="🔥"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🌊" ToolTip="Océano" Command="{Binding SelectEmojiCommand}" CommandParameter="🌊"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🌲" ToolTip="Bosque" Command="{Binding SelectEmojiCommand}" CommandParameter="🌲"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🌸" ToolTip="Flores" Command="{Binding SelectEmojiCommand}" CommandParameter="🌸"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="⚡" ToolTip="Tormenta" Command="{Binding SelectEmojiCommand}" CommandParameter="⚡"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="❄️" ToolTip="Frío" Command="{Binding SelectEmojiCommand}" CommandParameter="❄️"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🪐" ToolTip="Cosmos" Command="{Binding SelectEmojiCommand}" CommandParameter="🪐"/>

                                                                    <!-- Actividades -->
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🎬" ToolTip="Cine" Command="{Binding SelectEmojiCommand}" CommandParameter="🎬"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🎮" ToolTip="Gaming" Command="{Binding SelectEmojiCommand}" CommandParameter="🎮"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🎧" ToolTip="Música" Command="{Binding SelectEmojiCommand}" CommandParameter="🎧"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="📚" ToolTip="Lectura" Command="{Binding SelectEmojiCommand}" CommandParameter="📚"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="💻" ToolTip="Trabajo" Command="{Binding SelectEmojiCommand}" CommandParameter="💻"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="☕" ToolTip="Café" Command="{Binding SelectEmojiCommand}" CommandParameter="☕"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🍷" ToolTip="Cena" Command="{Binding SelectEmojiCommand}" CommandParameter="🍷"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🍳" ToolTip="Cocina" Command="{Binding SelectEmojiCommand}" CommandParameter="🍳"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🧘" ToolTip="Meditación" Command="{Binding SelectEmojiCommand}" CommandParameter="🧘"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🛌" ToolTip="Descanso" Command="{Binding SelectEmojiCommand}" CommandParameter="🛌"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🏋️" ToolTip="Fitness" Command="{Binding SelectEmojiCommand}" CommandParameter="🏋️"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🧹" ToolTip="Limpieza" Command="{Binding SelectEmojiCommand}" CommandParameter="🧹"/>

                                                                    <!-- Estilos -->
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="💡" ToolTip="Luz" Command="{Binding SelectEmojiCommand}" CommandParameter="💡"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🌈" ToolTip="RGB" Command="{Binding SelectEmojiCommand}" CommandParameter="🌈"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🎉" ToolTip="Fiesta" Command="{Binding SelectEmojiCommand}" CommandParameter="🎉"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="💖" ToolTip="Romance" Command="{Binding SelectEmojiCommand}" CommandParameter="💖"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🔮" ToolTip="Mágico" Command="{Binding SelectEmojiCommand}" CommandParameter="🔮"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🍸" ToolTip="Bar" Command="{Binding SelectEmojiCommand}" CommandParameter="🍸"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🎨" ToolTip="Arte" Command="{Binding SelectEmojiCommand}" CommandParameter="🎨"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🛸" ToolTip="Sci-Fi" Command="{Binding SelectEmojiCommand}" CommandParameter="🛸"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🚀" ToolTip="Energía" Command="{Binding SelectEmojiCommand}" CommandParameter="🚀"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="🤖" ToolTip="Cyber" Command="{Binding SelectEmojiCommand}" CommandParameter="🤖"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="💎" ToolTip="Diamante" Command="{Binding SelectEmojiCommand}" CommandParameter="💎"/>
                                                                    <Button Style="{StaticResource EmojiPillButton}" Content="✨" ToolTip="Destellos" Command="{Binding SelectEmojiCommand}" CommandParameter="✨"/>
                                                                </WrapPanel>
                                                            </StackPanel>

                                                            <!-- Edit Name Input + Save / Cancel -->
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Current Emoji Pill -->
                                                                <Border Grid.Column="0" Width="34" Height="30" CornerRadius="4"
                                                                        Background="#121216" BorderBrush="#0078D4" BorderThickness="1"
                                                                        Margin="0,0,8,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding EditIconText}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>

                                                                <!-- Edit Name TextBox -->
                                                                <TextBox Grid.Column="1" Text="{Binding EditNameText, UpdateSourceTrigger=PropertyChanged}"
                                                                         Background="#121216" Foreground="#FFFFFF" BorderBrush="#0078D4"
                                                                         Padding="8,5" FontSize="12" VerticalAlignment="Center"/>

                                                                <!-- Save & Cancel Buttons -->
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource PrimaryActionButton}" Command="{Binding SaveEditCommand}"
                                                                            Padding="12,5" Margin="0,0,4,0">
                                                                        <TextBlock Text="✓ Guardar"/>
                                                                    </Button>
                                                                    <Button Style="{StaticResource ActionButton}" Command="{Binding CancelEditCommand}"
                                                                            Padding="10,5">
                                                                        <TextBlock Text="✕ Cancelar"/>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- SUB-VIEW 2: MENÚ RÁPIDO BANDEJA (6 RANURAS TOTALMENTE PERSONALIZABLES) -->
                        <Grid Grid.Row="1" Visibility="{Binding SelectedScenesTabIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=2}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                     <Border Background="#17171C" BorderBrush="#25252E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc_QuickCustomizer_Title}" FontWeight="SemiBold" FontSize="14" Foreground="#FFFFFF"/>
                                            <TextBlock Text="{DynamicResource Loc_QuickCustomizer_Subtitle}"
                                                       FontSize="11" Foreground="#8A8A94" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 6 Slots Grid -->
                                    <ItemsControl ItemsSource="{Binding QuickSlots}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#17171C" BorderBrush="#25252E" BorderThickness="1" CornerRadius="8"
                                                        Padding="14,12" Margin="4">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Slot Title & Badge -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Background="#252530" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding SlotTitle}" FontWeight="Bold" FontSize="11" Foreground="#0078D4"/>
                                                                </Border>
                                                                <TextBlock Text="{DynamicResource Loc_SlotQuickButton}" FontSize="11" Foreground="#7E7E88" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Dropdown Selector -->
                                                        <ComboBox Grid.Row="1" ItemsSource="{Binding AvailableOptions}"
                                                                  SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                                  Background="#121216" Foreground="#FFFFFF"
                                                                  MinHeight="36" Padding="8,4" FontSize="12"
                                                                  VerticalAlignment="Center"
                                                                  VerticalContentAlignment="Center"
                                                                  HorizontalContentAlignment="Stretch">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Icon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                    </Grid>

                    <!-- VIEW 3: AJUSTES GENERALES & STREAM DECK / API REST LOCAL -->
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=3}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,0,10,20">
                                <!-- SECTION 1: AJUSTES GENERALES -->
                                <TextBlock Text="{DynamicResource Loc_GeneralSettings_Title}" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock Text="{DynamicResource Loc_GeneralSettings_Subtitle}"
                                           FontSize="12" Foreground="#7E7E88" Margin="0,4,0,16"/>

                                <Border Background="#17171C" BorderBrush="#25252E" BorderThickness="1" CornerRadius="8" Padding="18,16" Margin="0,0,0,24">
                                    <StackPanel>
                                        <!-- Option 1: Idioma -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Loc_Language}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                                <TextBlock Text="{DynamicResource Loc_Language_Help}" FontSize="11" Foreground="#7E7E88" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableLanguages}"
                                                      SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                                                      SelectedValuePath="Code"
                                                      DisplayMemberPath="DisplayName"
                                                      MinWidth="140" MinHeight="32" Padding="8,4" FontSize="12"
                                                      Background="#121216" Foreground="#FFFFFF"
                                                      VerticalAlignment="Center"
                                                      VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <Separator Background="#1F282832" Margin="0,0,0,14"/>

                                        <!-- Option 2: Iniciar con Windows -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Loc_StartWithWindows}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                                <TextBlock Text="{DynamicResource Loc_StartWithWindows_Help}" FontSize="11" Foreground="#7E7E88" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" Style="{StaticResource FluentToggleSwitch}"
                                                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                                          VerticalAlignment="Center"/>
                                        </Grid>

                                        <Separator Background="#1F282832" Margin="0,0,0,14"/>

                                        <!-- Option 3: Iniciar minimizado -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Loc_StartMinimized}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                                <TextBlock Text="{DynamicResource Loc_StartMinimized_Help}" FontSize="11" Foreground="#7E7E88" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" Style="{StaticResource FluentToggleSwitch}"
                                                          IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                                                          VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- SECTION 2: STREAM DECK & API REST LOCAL -->
                                <TextBlock Text="{DynamicResource Loc_StreamDeck_Title}" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock Text="{DynamicResource Loc_StreamDeck_Subtitle}"
                                           FontSize="12" Foreground="#7E7E88" Margin="0,4,0,16"/>

                                <Border Background="#17171C" BorderBrush="#25252E" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc_ServerActive}" FontWeight="SemiBold" Foreground="#10B981" FontSize="13"/>
                                        <TextBlock Text="{DynamicResource Loc_ListeningOn}" FontFamily="Consolas" FontSize="12" Foreground="#FFFFFF" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{DynamicResource Loc_AvailableEndpoints}" FontSize="10" FontWeight="Bold" Foreground="#6B6B75" Margin="0,0,0,10"/>

                                <Border Background="#17171C" BorderBrush="#25252E" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="GET http://localhost:38898/api/status" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#0078D4"/>
                                        <TextBlock Text="{DynamicResource Loc_EndpointStatus}" FontSize="11" Foreground="#7E7E88" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#17171C" BorderBrush="#25252E" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="POST http://localhost:38898/api/power/toggle?room=1" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#0078D4"/>
                                        <TextBlock Text="{DynamicResource Loc_EndpointPower}" FontSize="11" Foreground="#7E7E88" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#17171C" BorderBrush="#25252E" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="POST http://localhost:38898/api/brightness?value=80" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#0078D4"/>
                                        <TextBlock Text="{DynamicResource Loc_EndpointBrightness}" FontSize="11" Foreground="#7E7E88" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#17171C" BorderBrush="#25252E" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="POST http://localhost:38898/api/scenes/activate?name=MiEscena" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#0078D4"/>
                                        <TextBlock Text="{DynamicResource Loc_EndpointScenes}" FontSize="11" Foreground="#7E7E88" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>

            <!-- Fluent 2 Status Bar Footer -->
            <Border Grid.Row="2" Background="#28101014" BorderBrush="#1F282832" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#8E8E98"/>
                    <TextBlock Text="v1.0.0" FontSize="11" Foreground="#6B6B78" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
</ui:FluentWindow>
