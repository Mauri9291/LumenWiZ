<UserControl x:Class="LumenWiZ.UI.Controls.DeviceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LumenWiZ.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignWidth="600" d:DesignHeight="60">

    <UserControl.Resources>
        <Style x:Key="ColorDotButton" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="dot" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="#40FFFFFF" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="dot" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="dot" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#0CFFFFFF"
            BorderBrush="#1AFFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14,10"
            Margin="0,0,0,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Device identity & state indicator -->
                <ColumnDefinition Width="*"/>
                <!-- Color palette quick presets -->
                <ColumnDefinition Width="Auto"/>
                <!-- Brightness slider -->
                <ColumnDefinition Width="140"/>
                <!-- Audio sync button -->
                <ColumnDefinition Width="Auto"/>
                <!-- Power switch -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Identity: Color dot + Icon + Name + Subtitle -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Glowing Color Indicator Dot -->
                <Border Width="16" Height="16" CornerRadius="8"
                        Background="{Binding ColorHex, FallbackValue='#F59E0B'}"
                        BorderBrush="#40FFFFFF" BorderThickness="1"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#F59E0B" Opacity="0.8"/>
                    </Border.Effect>
                </Border>

                <!-- Name & Subtitle -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#F4F4F5"/>
                        <TextBlock Text="{Binding IsLightStrip, Converter={x:Null}}" Margin="6,0,0,0"
                                   FontSize="10" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Quick Color / Temp Presets -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                <Button Style="{StaticResource ColorDotButton}" Background="#FBBF24" ToolTip="Blanco Cálido 2700K"
                        Command="{Binding SetColorPresetCommand}" CommandParameter="warm"/>
                <Button Style="{StaticResource ColorDotButton}" Background="#FEF08A" ToolTip="Blanco Día 4000K"
                        Command="{Binding SetColorPresetCommand}" CommandParameter="daylight"/>
                <Button Style="{StaticResource ColorDotButton}" Background="#E0F2FE" ToolTip="Blanco Frío 6500K"
                        Command="{Binding SetColorPresetCommand}" CommandParameter="cool"/>
                <Button Style="{StaticResource ColorDotButton}" Background="#A855F7" ToolTip="Violeta Neón"
                        Command="{Binding SetColorPresetCommand}" CommandParameter="purple"/>
                <Button Style="{StaticResource ColorDotButton}" Background="#3B82F6" ToolTip="Azul Profundo"
                        Command="{Binding SetColorPresetCommand}" CommandParameter="blue"/>
                <Button Style="{StaticResource ColorDotButton}" Background="#10B981" ToolTip="Verde Esmeralda"
                        Command="{Binding SetColorPresetCommand}" CommandParameter="green"/>
                <Button Style="{StaticResource ColorDotButton}" Background="#EF4444" ToolTip="Rojo Pasión"
                        Command="{Binding SetColorPresetCommand}" CommandParameter="red"/>
            </StackPanel>

            <!-- Brightness Slider -->
            <Grid Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" Value="{Binding Brightness, Mode=TwoWay}"
                        Minimum="10" Maximum="100"
                        SmallChange="5" LargeChange="10"
                        VerticalAlignment="Center"
                        Foreground="#F59E0B"/>
                <TextBlock Grid.Column="1" Text="{Binding Brightness, StringFormat='{}{0}%'}"
                           FontSize="11" Foreground="#A1A1AA"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Audio Reactive Toggle Icon -->
            <ToggleButton Grid.Column="3" IsChecked="{Binding AudioSyncEnabled, Mode=TwoWay}"
                          ToolTip="Activar/Desactivar reacción al audio para esta luz"
                          Cursor="Hand" Margin="10,0" Width="30" Height="30"
                          VerticalAlignment="Center">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="btnBorder" CornerRadius="8" Background="#14FFFFFF"
                                BorderBrush="#20FFFFFF" BorderThickness="1">
                            <TextBlock Text="🎵" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#33A855F7"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#A855F7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <!-- Power Toggle Switch -->
            <ToggleButton Grid.Column="4" IsChecked="{Binding IsOn, Mode=TwoWay}"
                          Cursor="Hand" Width="44" Height="22" VerticalAlignment="Center">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="toggleBg" CornerRadius="11" Background="#33333A"
                                BorderBrush="#25FFFFFF" BorderThickness="1">
                            <Ellipse x:Name="thumb" Width="16" Height="16" Fill="#FFFFFF"
                                     HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="toggleBg" Property="Background" Value="#10B981"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
        </Grid>
    </Border>
</UserControl>
